<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حاسبة مكافأة نهاية الخدمة - حاسبها | نظام العمل السعودي</title>
    <meta name="description" content="حاسبة مكافأة نهاية الخدمة وفق نظام العمل السعودي. احسب مستحقاتك بناءً على الراتب ومدة الخدمة وسبب انتهاء العلاقة الوظيفية مع شرح كامل من وزارة الموارد البشرية.">
    <meta name="keywords" content="حاسبة نهاية الخدمة, مكافأة نهاية الخدمة السعودية, نظام العمل السعودي, End of Service Calculator Saudi, حقوق العامل">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://hasibhaa.netlify.app/eos.html">
    <meta property="og:title" content="حاسبة مكافأة نهاية الخدمة - حاسبها">
    <meta property="og:description" content="احسب مكافأة نهاية الخدمة وفق نظام العمل السعودي مع شرح كامل ومراجع رسمية.">
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:#f8fafc;color:#1e293b;line-height:1.6}
        .container{max-width:650px;margin:0 auto;padding:0 20px}
        .site-header{background:#fff;border-bottom:1px solid #e2e8f0;padding:16px 0}
        .header-content{display:flex;justify-content:space-between;align-items:center}
        .logo{font-size:26px;font-weight:800;color:#059669;text-decoration:none}
        .calc-wrapper{background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:28px 24px;margin:30px auto}
        .calc-wrapper h3{text-align:center;color:#064e3b;font-size:22px;margin-bottom:4px}
        .subtitle{text-align:center;color:#64748b;font-size:14px;margin-bottom:28px}
        label{display:block;font-weight:600;margin-bottom:6px;color:#1e293b;font-size:15px}
        .hint{font-size:12px;color:#94a3b8;margin-bottom:10px}
        .input-row{display:flex;gap:10px;margin-bottom:20px;align-items:center}
        .input-row input{padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:16px;text-align:right;color:#1e293b;flex:1}
        .input-row input:focus{outline:none;border-color:#059669}
        .full-width{margin-bottom:20px}
        .full-width select{width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:15px;background:#fff;color:#1e293b;cursor:pointer}
        .calc-btn{width:100%;background:#059669;color:#fff;border:none;padding:16px;border-radius:12px;font-size:18px;font-weight:700;cursor:pointer;margin-top:8px}
        .result-card{background:#f0fdf4;border:2px solid #059669;border-radius:16px;padding:24px;margin-top:24px;display:none}
        .result-card h4{text-align:center;color:#064e3b;font-size:16px;margin-bottom:20px}
        .summary-table{width:100%;border-collapse:collapse}
        .summary-table td{padding:10px 4px;border-bottom:1px solid #d1fae5;font-size:13px}
        .summary-table td:first-child{color:#64748b;width:45%}
        .summary-table td:last-child{color:#1e293b;font-weight:700;text-align:left}
        .summary-table tr:last-child td{border-bottom:none;font-size:18px;color:#059669;font-weight:900;padding-top:14px}
        .note-box{background:#fffbeb;border:1px solid #fcd34d;border-radius:12px;padding:16px;margin-top:20px;font-size:13px;color:#92400e;line-height:1.7}
        .back-link{display:inline-block;margin-top:20px;color:#059669;text-decoration:underline;font-size:14px}
        .article-box{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:28px;margin-top:24px;line-height:2.2}
        .article-box h2{font-size:20px;color:#064e3b;margin-bottom:16px}
        .article-box h3{font-size:16px;color:#1e293b;margin-top:20px;text-align:right}
        .article-box p{color:#475569;font-size:14px}
        .article-box ul{color:#475569;font-size:14px;padding-right:20px}
        .article-box a{color:#059669;text-decoration:underline}
        @media(max-width:600px){.calc-wrapper{padding:20px 16px}.article-box{padding:16px}}
    </style>
</head>
<body>

<header class="site-header">
    <div class="container">
        <div class="header-content">
            <a href="index.html" class="logo">🧮 حاسبها</a>
            <a href="index.html" style="color:#059669;text-decoration:none;font-weight:600">الرئيسية</a>
        </div>
    </div>
</header>

<main>
    <div class="container">
        <div class="calc-wrapper">
            <h3>📋 حاسبة مكافأة نهاية الخدمة</h3>
            <p class="subtitle">احسب مكافأة نهاية الخدمة بسهولة وفق نظام العمل السعودي.</p>
            
            <label>الراتب الإجمالي</label>
            <p class="hint">آخر راتب إجمالي شامل الأساسي والبدلات.</p>
            <div class="input-row"><input type="number" id="eosSalary" placeholder="أدخل الراتب الإجمالي" oninput="updateAll()"><span style="font-weight:600;color:#64748b">ريال</span></div>
            
            <label>تاريخ بداية العمل</label>
            <div class="input-row"><input type="date" id="eosStartDate" onchange="updateAll()"></div>
            
            <label>تاريخ انتهاء العمل</label>
            <div class="input-row"><input type="date" id="eosEndDate" onchange="updateAll()"></div>
            
            <label>نوع العقد</label>
            <div class="full-width"><select id="eosContractType" onchange="updateAll()"><option value="">-- اختر نوع العقد --</option><option value="limited">محدد المدة</option><option value="unlimited">غير محدد المدة</option></select></div>
            
            <label>سبب انتهاء العلاقة الوظيفية</label>
            <div class="full-width">
                <select id="eosReason" onchange="updateAll()">
                    <option value="">-- اختر سبب الإنهاء --</option>
                    <option value="resign">استقالة الموظف</option>
                    <option value="end_contract">انتهاء العقد بانتهاء مدته</option>
                    <option value="mutual_74">اتفاق الطرفين - المادة (74)</option>
                    <option value="terminate_80">فسخ العقد من صاحب العمل - المادة (80)</option>
                    <option value="probation_53">فسخ العقد خلال التجربة - المادة (53)</option>
                    <option value="activity_end_74">إنهاء النشاط - المادة (74)</option>
                    <option value="close_business_74">إغلاق المنشأة - المادة (74)</option>
                    <option value="retirement_74">بلوغ سن التقاعد - المادة (74)</option>
                    <option value="unlawful_77">إنهاء دون سبب مشروع - المادة (77)</option>
                    <option value="worker_terminate_81">فسخ العقد من العامل - المادة (81)</option>
                    <option value="worker_death_79">وفاة العامل - المادة (79)</option>
                    <option value="disability_79">عجز العامل - المادة (79)</option>
                    <option value="work_injury_137">عجز بسبب إصابة عمل - المادة (137)</option>
                    <option value="marriage_87">إنهاء العقد بسبب الزواج - المادة (87)</option>
                    <option value="childbirth_87">إنهاء العقد بسبب الولادة - المادة (87)</option>
                </select>
            </div>
            
            <button class="calc-btn" onclick="updateAll()">احسب المكافأة</button>
            
            <div class="result-card" id="eosResult">
                <h4>📋 ملخص حساب المكافأة</h4>
                <table class="summary-table">
                    <tr><td>نوع العقد</td><td id="eosContractDisplay">—</td></tr>
                    <tr><td>سبب الإنهاء</td><td id="eosReasonDisplay">—</td></tr>
                    <tr><td>الراتب الإجمالي</td><td id="eosSalaryDisplay">—</td></tr>
                    <tr><td>تاريخ بداية العقد</td><td id="eosStartDisplay">—</td></tr>
                    <tr><td>تاريخ انتهاء العقد</td><td id="eosEndDisplay">—</td></tr>
                    <tr><td>المكافأة المحسوبة</td><td id="eosAmount">0.00 ريال</td></tr>
                </table>
            </div>
            
            <div class="note-box">
                <strong>📝 تنبيه:</strong> هذه الحاسبة تقدم تقديرًا لمكافأة نهاية الخدمة وفق أحكام نظام العمل السعودي. قد تختلف النتيجة في بعض الحالات الخاصة.
            </div>
            
            <div class="article-box">
                <h2>🗂️ كل ما تحتاج معرفته عن مكافأة نهاية الخدمة في السعودية</h2>
                
                <h3>ما هي مكافأة نهاية الخدمة؟</h3>
                <p>مكافأة نهاية الخدمة هي حق مالي للعامل عند انتهاء علاقته الوظيفية، يصرفها صاحب العمل وفق أحكام نظام العمل السعودي الصادر بالمرسوم الملكي رقم (م/51). تحسب على أساس آخر راتب أساسي ومدة الخدمة وسبب انتهاء العلاقة.</p>
                
                <h3>كيف تُحسب المكافأة؟</h3>
                <p><strong>أول 5 سنوات:</strong> نصف شهر عن كل سنة خدمة.</p>
                <p><strong>بعد 5 سنوات:</strong> شهر كامل عن كل سنة إضافية.</p>
                <p>تحسب كسور السنة (الأشهر والأيام) بنسبة من السنة الكاملة.</p>
                
                <h3>حالات الاستقالة والاستحقاق</h3>
                <p>إذا استقال الموظف، تختلف نسبة الاستحقاق حسب مدة الخدمة:</p>
                <ul>
                    <li><strong>أقل من سنتين:</strong> لا يستحق مكافأة.</li>
                    <li><strong>من 2 إلى 5 سنوات:</strong> يستحق ثلث المكافأة.</li>
                    <li><strong>من 5 إلى 10 سنوات:</strong> يستحق ثلثي المكافأة.</li>
                    <li><strong>أكثر من 10 سنوات:</strong> يستحق كامل المكافأة.</li>
                </ul>
                
                <h3>حالات لا تستحق فيها المكافأة</h3>
                <p>إذا تم فسخ العقد من قبل صاحب العمل لأحد الأسباب الواردة في المادة (80) من نظام العمل، أو فسخ العامل للعقد دون سبب مشروع (المادة 81)، أو خلال فترة التجربة (المادة 53).</p>
                
                <h3>نصائح هامة</h3>
                <ul>
                    <li>تأكد من أن عقد العمل موثق في منصة قوى أو وزارة الموارد البشرية.</li>
                    <li>احتفظ بسجل الرواتب وكشوف الحضور.</li>
                    <li>استخدم حاسبة مكافأة نهاية الخدمة أعلاه للتأكد من استحقاقك قبل التوجه للموارد البشرية.</li>
                    <li>لأي نزاع عمالي، يمكنك رفع دعوى عبر منصة "ودي" التابعة لوزارة العدل.</li>
                </ul>
                
                <h3>المراجع الرسمية</h3>
                <ul>
                    <li>وزارة الموارد البشرية والتنمية الاجتماعية: <a href="https://www.hrsd.gov.sa" target="_blank">HRSD.gov.sa</a></li>
                    <li>نظام العمل السعودي: <a href="https://laws.boe.gov.sa" target="_blank">laws.boe.gov.sa</a></li>
                    <li>منصة قوى: <a href="https://www.qiwa.sa" target="_blank">Qiwa.sa</a></li>
                    <li>منصة ودي (تسوية النزاعات العمالية): <a href="https://www.moj.gov.sa" target="_blank">moj.gov.sa</a></li>
                </ul>
            </div>
            
            <a href="index.html" class="back-link">↩ الرجوع للقائمة الرئيسية</a>
        </div>
    </div>
</main>

<script>
function formatNumber(num) { return num.toLocaleString('ar-SA', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }
function formatInt(num) { return num.toLocaleString('ar-SA'); }

function updateAll() {
    var salary = parseFloat(document.getElementById('eosSalary').value) || 0;
    var startDateVal = document.getElementById('eosStartDate').value;
    var endDateVal = document.getElementById('eosEndDate').value;
    var contractType = document.getElementById('eosContractType').value;
    var reason = document.getElementById('eosReason').value;
    var contractText = document.getElementById('eosContractType').selectedOptions[0]?.text || '—';
    var reasonText = document.getElementById('eosReason').selectedOptions[0]?.text || '—';
    
    document.getElementById('eosSalaryDisplay').textContent = salary > 0 ? formatInt(salary) + ' ريال' : '—';
    document.getElementById('eosContractDisplay').textContent = contractText;
    document.getElementById('eosReasonDisplay').textContent = reasonText;
    document.getElementById('eosStartDisplay').textContent = startDateVal || '—';
    document.getElementById('eosEndDisplay').textContent = endDateVal || '—';
    document.getElementById('eosResult').style.display = 'block';
    
    if (!salary || !startDateVal || !endDateVal || !contractType || !reason) {
        document.getElementById('eosAmount').textContent = '0.00 ريال';
        return;
    }
    
    var startDate = new Date(startDateVal), endDate = new Date(endDateVal);
    var totalDays = Math.floor((endDate - startDate) / (1000 * 60 * 60 * 24));
    if (totalDays < 0) totalDays = 0;
    
    var totalYears = totalDays / 365;
    var firstPeriod = Math.min(totalYears, 5), secondPeriod = Math.max(totalYears - 5, 0);
    var fullAward = (salary * 0.5 * firstPeriod) + (salary * secondPeriod);
    var award = fullAward;
    
    if (reason === 'resign') {
        if (totalYears < 2) award = 0;
        else if (totalYears <= 5) award = fullAward * (1/3);
        else if (totalYears <= 10) award = fullAward * (2/3);
    }
    if (reason === 'probation_53' || reason === 'terminate_80' || reason === 'worker_terminate_81') award = 0;
    
    document.getElementById('eosAmount').textContent = formatNumber(award) + ' ريال';
}
</script>
</body>
</html>
